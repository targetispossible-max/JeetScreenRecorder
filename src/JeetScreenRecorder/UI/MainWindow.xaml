<Window x:Class="JeetScreenRecorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeet Screen Recorder" Width="1060" Height="820" MinWidth="900" MinHeight="640"
        Icon="pack://application:,,,/Assets/JeetScreenRecorder.ico"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Ideal">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A1020" Offset="0"/>
            <GradientStop Color="#0D1730" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
    </Window.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/logo256.png" Width="54" Height="54" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Jeet Screen Recorder" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Record your screen in HD with webcam and clear sound" Foreground="{StaticResource Text2Brush}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="16" Padding="14,6" VerticalAlignment="Center"
                        Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Messages ===== -->
        <Border Grid.Row="1" Visibility="{Binding HasMessage, Converter={StaticResource B2V}}"
                Background="#2A2410" BorderBrush="#6B5A1A" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <!-- ===== Body ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ LEFT COLUMN ============ -->
                <StackPanel Grid.Column="0">

                    <!-- Record controls -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding TimerText}" Foreground="{StaticResource TextBrush}" FontSize="58"
                                       FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button Content="●  Start Recording   (F9)" Command="{Binding StartCommand}"
                                    Style="{StaticResource DangerButton}" FontSize="19" Padding="20,15" Margin="4,0,4,8"/>
                            <UniformGrid Columns="2">
                                <Button Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                                <Button Content="■  Stop" Command="{Binding StopCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                                <Button Content="📷  Screenshot (F11)" Command="{Binding ScreenshotCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                                <Button Content="✏  Annotate (F8)" Command="{Binding AnnotateCommand}"
                                        Style="{StaticResource SecondaryButton}" Background="#5B34C9"/>
                            </UniformGrid>
                            <TextBlock Text="{Binding StatsText}" Foreground="{StaticResource Text2Brush}" FontSize="13"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Screen & video -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel IsEnabled="{Binding CanEditSettings}">
                            <TextBlock Text="🖥  Screen &amp; video quality" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Quick preset" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding PresetOptions}"
                                      SelectedItem="{Binding SelectedPreset}" Margin="0,0,0,10"/>

                            <TextBlock Text="What to record" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding CaptureAreaOptions}"
                                      SelectedItem="{Binding SelectedCaptureArea}" Margin="0,0,0,10"/>

                            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsRegionMode, Converter={StaticResource B2V}}">
                                <Button Content="⬚  Select region…" Command="{Binding SelectRegionCommand}"
                                        Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding RegionText}" Style="{StaticResource HintText}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,10" Visibility="{Binding IsWindowMode, Converter={StaticResource B2V}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding WindowOptions}"
                                          DisplayMemberPath="Display" SelectedItem="{Binding SelectedWindow}"/>
                                <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshWindowsCommand}"
                                        Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Screen" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding MonitorOptions}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedMonitor}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Quality" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding QualityOptions}"
                                              SelectedItem="{Binding SelectedQuality}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Resolution" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding ResolutionOptions}"
                                              SelectedItem="{Binding SelectedResolution}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Frame rate (FPS)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding FpsOptions}"
                                              SelectedItem="{Binding SelectedFps}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Countdown" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding CountdownOptions}"
                                              SelectedItem="{Binding SelectedCountdown}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Capture method" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding CaptureMethodOptions}"
                                      SelectedItem="{Binding SelectedCaptureMethod}" Margin="0,0,0,12"/>

                            <CheckBox Style="{StaticResource ModernCheck}" Content="Hide this app from recordings and screenshots"
                                      IsChecked="{Binding HideFromCapture}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ RIGHT COLUMN ============ -->
                <StackPanel Grid.Column="2">

                    <!-- Webcam -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel IsEnabled="{Binding CanEditSettings}">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="📷  Webcam" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource ModernCheck}" Content="Add to video" HorizontalAlignment="Right"
                                          IsChecked="{Binding WebcamEnabled}"/>
                            </Grid>

                            <StackPanel IsEnabled="{Binding WebcamEnabled}">
                                <TextBlock Text="Camera" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding CameraOptions}"
                                              DisplayMemberPath="Name" SelectedValuePath="Name"
                                              SelectedValue="{Binding SelectedCameraName}"/>
                                    <Button Grid.Column="1" Content="↻ Detect" Command="{Binding DetectCamerasCommand}"
                                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Position" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding WebcamPositionOptions}"
                                                  SelectedItem="{Binding SelectedWebcamPosition}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Size" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding WebcamSizeOptions}"
                                                  SelectedItem="{Binding SelectedWebcamSize}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="While recording the camera shows on screen: drag it to move, use the mouse wheel or the corner handle to make it bigger or smaller."/>
                                <CheckBox Style="{StaticResource ModernCheck}" Content="Mirror the camera picture"
                                          IsChecked="{Binding WebcamMirror}" Margin="0,0,0,10"/>

                                <Button Content="🔍  Test camera" Command="{Binding TestCameraCommand}"
                                        Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding CameraStatus}" Style="{StaticResource HintText}"/>

                                <Border Visibility="{Binding HasCameraPreview, Converter={StaticResource B2V}}" Margin="0,10,0,0"
                                        Background="Black" CornerRadius="10" Padding="2" Height="170">
                                    <Image Source="{Binding CameraPreview}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WebcamMirror}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="-1" ScaleY="1"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audio -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="🎚  Audio mixer" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Microphone device" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding MicOptions}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedMicId}"
                                      IsEnabled="{Binding CanEditSettings}" Margin="0,0,0,14"/>

                            <CheckBox Style="{StaticResource ModernCheck}" Content="🎙  Microphone" IsChecked="{Binding MicEnabled}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="400" Value="{Binding MicVolume}"/>
                                <ProgressBar Grid.Column="2" Style="{StaticResource LevelBar}" Value="{Binding MicLevel, Mode=OneWay}"
                                             VerticalAlignment="Center"/>
                            </Grid>

                            <CheckBox Style="{StaticResource ModernCheck}" Content="🔊  System audio" IsChecked="{Binding SystemEnabled}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Value="{Binding SystemVolume}"/>
                                <ProgressBar Grid.Column="2" Style="{StaticResource LevelBar}" Foreground="{StaticResource AccentBrush}"
                                             Value="{Binding SystemLevel, Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Button Content="{Binding TestLabel}" Command="{Binding TestAudioCommand}"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Output -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="💾  Output" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding EncoderText}" Foreground="{StaticResource Text2Brush}" FontSize="12.5" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EstimateText}" Foreground="{StaticResource Text2Brush}" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding OutputText}" Style="{StaticResource HintText}" Margin="0,6,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="📁  Open folder" Command="{Binding OpenFolderCommand}"
                                        Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                                <Button Content="Change folder…" Command="{Binding ChooseFolderCommand}"
                                        Style="{StaticResource SmallButton}" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Footer ===== -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Created by Amarjeet K Gupta  •  WhatsApp: 8707018073"
                       Foreground="{StaticResource Text2Brush}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="🔒 Your recordings remain on your computer."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</Window>
