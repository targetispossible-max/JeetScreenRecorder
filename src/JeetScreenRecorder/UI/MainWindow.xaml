<Window x:Class="JeetScreenRecorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeet Screen Recorder" Width="800" Height="860" MinWidth="700" MinHeight="620"
        Background="#12141A" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C1F27"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
            <TextBlock Text="Jeet Screen Recorder" Foreground="White" FontSize="22"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Created by Amarjeet K Gupta  •  WhatsApp: 8707018073"
                       Foreground="#9AA3B2" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680">

                <!-- Recording controls -->
                <Border Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="#9AA3B2" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TimerText}" Foreground="White" FontSize="56"
                                   FontWeight="Light" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                        <Button Content="● Start Recording  (F9)" Command="{Binding StartCommand}"
                                Style="{StaticResource BigButton}" Background="#E5484D" FontSize="20" Padding="40,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}"
                                    Style="{StaticResource BigButton}" Background="#3B82F6"/>
                            <Button Content="■ Stop" Command="{Binding StopCommand}"
                                    Style="{StaticResource BigButton}" Background="#4B5563"/>
                            <Button Content="📷 Screenshot (F11)" Command="{Binding ScreenshotCommand}"
                                    Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="14"/>
                            <Button Content="✏ Annotate (F8)" Command="{Binding AnnotateCommand}"
                                    Style="{StaticResource BigButton}" Background="#7C3AED" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatsText}" Foreground="#D1D5DB" FontSize="14"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="560" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Capture settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel IsEnabled="{Binding CanEditSettings}">
                        <TextBlock Text="🖥  Screen &amp; video" Style="{StaticResource Heading}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Preset" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Column="1" Margin="0,0,16,0"
                                      ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}"/>
                            <TextBlock Grid.Column="2" Text="Record" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding CaptureAreaOptions}" SelectedItem="{Binding SelectedCaptureArea}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding IsRegionMode, Converter={StaticResource B2V}}">
                            <Button Content="⬚ Select region…" Command="{Binding SelectRegionCommand}"
                                    Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="13"
                                    Padding="14,7" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding RegionText}" Style="{StaticResource Label}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding IsWindowMode, Converter={StaticResource B2V}}">
                            <ComboBox Width="440" ItemsSource="{Binding WindowOptions}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedWindow}"/>
                            <Button Content="↻ Refresh" Command="{Binding RefreshWindowsCommand}"
                                    Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="13"
                                    Padding="12,6" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Screen" Style="{StaticResource Label}" Grid.Row="0" Grid.Column="0" Margin="0,0,10,8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                      ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedMonitor}"/>

                            <TextBlock Text="FPS" Style="{StaticResource Label}" Grid.Row="1" Grid.Column="0" Margin="0,0,10,8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,16,8"
                                      ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}"/>
                            <TextBlock Text="Resolution" Style="{StaticResource Label}" Grid.Row="1" Grid.Column="2" Margin="0,0,10,8"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"
                                      ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}"/>

                            <TextBlock Text="Quality" Style="{StaticResource Label}" Grid.Row="2" Grid.Column="0" Margin="0,0,10,8"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,16,8"
                                      ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"/>
                            <TextBlock Text="Countdown" Style="{StaticResource Label}" Grid.Row="2" Grid.Column="2" Margin="0,0,10,8"/>
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"
                                      ItemsSource="{Binding CountdownOptions}" SelectedItem="{Binding SelectedCountdown}"/>

                            <TextBlock Text="Capture" Style="{StaticResource Label}" Grid.Row="3" Grid.Column="0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                      ItemsSource="{Binding CaptureMethodOptions}" SelectedItem="{Binding SelectedCaptureMethod}"/>
                        </Grid>
                        <CheckBox Content="Hide this app from recordings and screenshots"
                                  IsChecked="{Binding HideFromCapture}" Foreground="#D1D5DB" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Audio -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🎚  Audio mixer" Style="{StaticResource Heading}"/>
                        <ComboBox ItemsSource="{Binding MicOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedMicId}" IsEnabled="{Binding CanEditSettings}"
                                  Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" Content="🎙 Microphone" Foreground="White"
                                      IsChecked="{Binding MicEnabled}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MicVolume}"
                                    VerticalAlignment="Center" Margin="0,0,12,10"/>
                            <ProgressBar Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="100" Height="8"
                                         Value="{Binding MicLevel, Mode=OneWay}" Foreground="#22C55E"
                                         Background="#2A2F3A" BorderThickness="0" Margin="0,0,0,10"/>

                            <CheckBox Grid.Row="1" Grid.Column="0" Content="🔊 System audio" Foreground="White"
                                      IsChecked="{Binding SystemEnabled}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SystemVolume}"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ProgressBar Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="100" Height="8"
                                         Value="{Binding SystemLevel, Mode=OneWay}" Foreground="#3B82F6"
                                         Background="#2A2F3A" BorderThickness="0"/>
                        </Grid>
                        <Button Content="{Binding TestLabel}" Command="{Binding TestAudioCommand}"
                                Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="13"
                                Padding="14,7" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Output -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding EncoderText}" Foreground="#9AA3B2" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding OutputText}" Foreground="#6B7280" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding EstimateText}" Foreground="#9AA3B2" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="📁 Open folder" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="13"
                                    Padding="14,7" Margin="0,0,8,0"/>
                            <Button Content="Change folder…" Command="{Binding ChooseFolderCommand}"
                                    Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="13"
                                    Padding="14,7" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="#FBBF24" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Created by Amarjeet K Gupta  •  WhatsApp: 8707018073"
                       Foreground="#9AA3B2" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="🔒 Your recordings remain on your computer."
                       Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</Window>
