<Window x:Class="JeetScreenRecorder.Licensing.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeet Screen Recorder – License"
        Width="500" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/JeetScreenRecorder.ico">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A1020" Offset="0"/>
            <GradientStop Color="#0D1730" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#18233B"/>
            <Setter Property="Foreground"      Value="#F2F6FD"/>
            <Setter Property="CaretBrush"      Value="#F2F6FD"/>
            <Setter Property="BorderBrush"     Value="#263553"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#6C7C99" Padding="12,8"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="12,8"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔑  License" Foreground="#F2F6FD" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="txtStatus" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock x:Name="txtDetail" FontSize="13" Foreground="#A3B3CF" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Row="1" Height="1" Background="#263553" Margin="0,0,0,20"/>

        <!-- Activate form + Buy -->
        <StackPanel Grid.Row="2" x:Name="sectionActivate">
            <TextBlock Text="Enter License Key" Foreground="#A3B3CF" FontSize="12.5" Margin="0,0,0,6"/>
            <TextBox x:Name="txtKey" Tag="JEET-XXXX-XXXX-XXXX"
                     FontFamily="Consolas" FontSize="15" Margin="0,0,0,10"/>
            <Button x:Name="btnActivate" Content="✔  Activate License"
                    Style="{StaticResource PrimaryButton}" Click="BtnActivate_Click"
                    HorizontalAlignment="Stretch" Height="42" FontSize="14"/>

            <Border Height="1" Background="#263553" Margin="0,20,0,20"/>

            <TextBlock Text="Don't have a license key yet?" Foreground="#A3B3CF"
                       FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <Button x:Name="btnBuy" Content="🛒  Buy License"
                    Style="{StaticResource DangerButton}" Click="BtnBuy_Click"
                    HorizontalAlignment="Stretch" Height="42" FontSize="14"/>

            <!-- Deactivate (only when licensed) -->
            <StackPanel x:Name="sectionDeactivate" Visibility="Collapsed" Margin="0,20,0,0">
                <Border Height="1" Background="#263553" Margin="0,0,0,16"/>
                <TextBlock Text="To use this license on a different PC, first deactivate it here."
                           Foreground="#6C7C99" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button x:Name="btnDeactivate" Content="🔓  Deactivate This PC"
                        Style="{StaticResource SecondaryButton}" Click="BtnDeactivate_Click"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <!-- Message -->
        <TextBlock x:Name="txtMsg" Grid.Row="3"
                   FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                   Foreground="#A3B3CF"/>

        <!-- Close -->
        <Button Grid.Row="4" Content="Close" Click="BtnClose_Click"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
