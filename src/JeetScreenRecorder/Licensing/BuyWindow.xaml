<Window x:Class="JeetScreenRecorder.Licensing.BuyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buy Jeet Screen Recorder License"
        Width="520" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/JeetScreenRecorder.ico">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A1020" Offset="0"/>
            <GradientStop Color="#0D1730" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#18233B"/>
            <Setter Property="Foreground"      Value="#F2F6FD"/>
            <Setter Property="CaretBrush"      Value="#F2F6FD"/>
            <Setter Property="BorderBrush"     Value="#263553"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#6C7C99" Padding="12,8"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="12,8"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="🛒  Buy License" Foreground="#F2F6FD" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="1 year license  •  1 PC  •  All future updates included"
                           Foreground="#A3B3CF" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Main form panel -->
            <StackPanel Grid.Row="1" x:Name="panelForm">

                <!-- Name -->
                <TextBlock Text="Full Name" Foreground="#A3B3CF" FontSize="12.5" Margin="0,0,0,4"/>
                <TextBox x:Name="txtName" Tag="Your full name" Margin="0,0,0,12"/>

                <!-- Email -->
                <TextBlock Text="Email" Foreground="#A3B3CF" FontSize="12.5" Margin="0,0,0,4"/>
                <TextBox x:Name="txtEmail" Tag="license@example.com" Margin="0,0,0,12"/>

                <!-- Mobile -->
                <TextBlock Text="Mobile (Indian number)" Foreground="#A3B3CF" FontSize="12.5" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMobile" Tag="9876543210" Margin="0,0,0,16"/>

                <!-- Coupon -->
                <TextBlock Text="Coupon Code (optional)" Foreground="#A3B3CF" FontSize="12.5" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtCoupon" Tag="e.g. SAVE20" TextChanged="TxtCoupon_TextChanged"/>
                    <Button x:Name="btnCouponValidate" Grid.Column="1"
                            Content="Apply" Click="BtnValidateCoupon_Click"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="txtCouponMsg" Foreground="#6C7C99" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Separator -->
                <Border Height="1" Background="#263553" Margin="0,0,0,16"/>

                <!-- Payment method -->
                <TextBlock Text="Choose Payment Method" Foreground="#A3B3CF" FontSize="12.5" Margin="0,0,0,10"/>

                <Button x:Name="btnRazorpay"
                        Content="💳  Pay with Razorpay (UPI / Card / Net Banking)"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnRazorpay_Click"
                        HorizontalAlignment="Stretch" Height="46" FontSize="14" Margin="0,0,0,10"/>

                <Button x:Name="btnUpi"
                        Content="📱  Manual UPI + Screenshot"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnUpi_Click"
                        HorizontalAlignment="Stretch" Height="42" FontSize="13.5"/>

                <TextBlock Foreground="#6C7C99" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Razorpay: payment window opens in your browser. Manual UPI: you transfer and upload a screenshot for admin to verify."/>
            </StackPanel>

            <!-- Pending payment panel (shown after payment started) -->
            <StackPanel Grid.Row="1" x:Name="panelPending" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳  Waiting for payment…" Foreground="#FBBF24"
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,16"/>
                <TextBlock x:Name="txtPayStatus"
                           Foreground="#A3B3CF" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"
                           Text="The payment page opened in your browser. Complete the payment and this window will update automatically."/>
                <Button Content="I paid already – try a different key instead"
                        Style="{StaticResource SmallButton}"
                        Click="BtnChangePayment_Click" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="txtMsg" Grid.Row="2"
                       FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       Foreground="#A3B3CF"/>

            <!-- Close -->
            <Button Grid.Row="3" x:Name="btnCancel" Content="Cancel"
                    Click="BtnCancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" Margin="0,10,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>
